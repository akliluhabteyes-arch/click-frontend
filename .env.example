# Address of the ClickAddis backend API.
#  - Local development: put this line in .env.development (already done)
#  - Vercel / Netlify / Render: add VITE_API_URL as an environment variable in the
#    hosting dashboard, then redeploy (the value is built into the site).
VITE_API_URL=https://your-backend.onrender.com/api
